<?xml version="1.0"?>
<tryton>
    <data grouped="1">
        <record model="ir.message" id="msg_missing_first_name">
            <field name="text">Debe informar el nombre.</field>
        </record>
        <record model="ir.message" id="msg_missing_last_name">
            <field name="text">Debe informar el apellido.</field>
        </record>
        <record model="ir.message" id="msg_missing_ref">
            <field name="text">Debe informar el DNI / mocIDUP.</field>
        </record>
        <record model="ir.message" id="msg_missing_gender">
            <field name="text">Debe informar el genero.</field>
        </record>
        <record model="ir.message" id="msg_missing_street">
            <field name="text">Debe informar la calle de la direccion principal.</field>
        </record>
        <record model="ir.message" id="msg_missing_city">
            <field name="text">Debe informar la ciudad de la direccion principal.</field>
        </record>
        <record model="ir.message" id="msg_missing_country">
            <field name="text">Debe informar el pais de la direccion principal.</field>
        </record>
        <record model="ir.message" id="msg_missing_insurance_company">
            <field name="text">Debe seleccionar la obra social.</field>
        </record>
        <record model="ir.message" id="msg_missing_insurance_number">
            <field name="text">Debe informar el numero de afiliado.</field>
        </record>
        <record model="ir.message" id="msg_duplicate_party_for_ref">
            <field name="text">Existe mas de una persona con el DNI / mocIDUP %(ref)s. Revise los datos antes de continuar.</field>
        </record>
        <record model="ir.message" id="msg_patient_already_exists">
            <field name="text">Ya existe un paciente para el DNI / mocIDUP %(ref)s (%(patient)s).</field>
        </record>
        <record model="ir.message" id="msg_insurance_number_in_use">
            <field name="text">La obra social %(company)s ya tiene registrado el numero de afiliado %(number)s para otra persona.</field>
        </record>
        <record model="ir.message" id="msg_summary_person">
            <field name="text">Paciente: %(first_name)s %(last_name)s | DNI / mocIDUP: %(ref)s</field>
        </record>
        <record model="ir.message" id="msg_summary_address">
            <field name="text">Direccion: %(street)s %(street_number)s | Unidad: %(unit)s | Ciudad: %(city)s | CP: %(zip)s</field>
        </record>
        <record model="ir.message" id="msg_summary_insurance">
            <field name="text">Obra social: %(company)s | Afiliado: %(number)s | Plan: %(plan)s</field>
        </record>
        <record model="ir.message" id="msg_existing_party_notice">
            <field name="text">Se reutilizara la persona existente %(party)s para el DNI / mocIDUP %(ref)s.</field>
        </record>
        <record model="ir.message" id="msg_existing_party_fill_only_empty">
            <field name="text">Solo se completaran campos vacios; no se sobrescribiran datos ya cargados.</field>
        </record>
    </data>
</tryton>
